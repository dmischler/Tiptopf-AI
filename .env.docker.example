# Copy to .env.docker and fill in your values.
# docker compose injects this file into the container (see docker-compose.yml).
# Do not commit .env.docker.

DATA_DIR=/app/data

# API keys and AI model settings are configured in the app UI:
# /profile -> "API- und Modell-Konfiguration"

# App runtime. For Tailscale Serve / MagicDNS use https://<machine>.<tailnet>.ts.net
# Rebuild after changing this so server action allowedOrigins includes the host.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional shared PIN (empty = disabled). When set, /gate asks for this PIN.
ACCESS_PIN=

# Allow outbound http:// fetches (recipe blogs). Default is https only.
# Set to 1 only if you extract from http sites. Private IPs stay blocked.
ALLOW_HTTP_FETCH=
