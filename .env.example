# Environment Variables

# Local data directory (absolute or project-relative path)
DATA_DIR=./data

# OpenCode Go API key (required for AI features)
OPENCODE_API_KEY=your_opencode_api_key

# Optional: API base URL override (defaults to https://opencode.ai/zen/v1)
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1

# Optional: model override (defaults to minimax-m2.5)
# OPENCODE_MODEL_ID=minimax-m2.5

# Optional: free stock image lookup used before AI generation
# PEXELS_API_KEY=your_pexels_api_key
