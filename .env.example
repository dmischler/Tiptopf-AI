# Environment Variables

# Local data directory (absolute or project-relative path)
DATA_DIR=./data

# API keys and AI model settings are configured in the app UI:
# /profile -> "API- und Modell-Konfiguration"

# App runtime
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional shared PIN (empty = disabled). When set, /gate asks for this PIN.
ACCESS_PIN=

# Allow outbound http:// fetches (recipe blogs). Default is https only.
# Private, loopback, link-local, and CGNAT destinations stay blocked.
ALLOW_HTTP_FETCH=
